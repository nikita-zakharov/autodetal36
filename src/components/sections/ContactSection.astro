---
import ContactLinks from "../ContactLinks.astro";
---

<section class="cta" id="contacts">
  <div class="wrap">
    <div class="cta-panel">
      <div>
        <div class="kicker">АвтоДеталь36</div>
        <h2>Нужно быстро купить автозапчасть?</h2>
        <p>
          Сравним предложения поставщиков, сообщим цену и согласуем удобный
          способ получения.
        </p>
        <div class="actions">
          <ContactLinks />
        </div>
      </div>
      <span class="cta-brand-mark" aria-hidden="true">А</span>
    </div>
  </div>
</section>
